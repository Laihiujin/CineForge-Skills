{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CineForge Shot",
  "type": "object",
  "required": [
    "shot_id",
    "scene_id",
    "duration_s",
    "purpose",
    "state",
    "prompt",
    "acceptance"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "pattern": "^SH-"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^SC-"
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "purpose": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "required": [
        "inherit",
        "change",
        "must_not_change"
      ],
      "properties": {
        "inherit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}